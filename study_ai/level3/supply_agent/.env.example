# .env.example — 模板（cp .env.example .env 后填真钥匙；真 .env 不进库）
# 集中读取在 config.py；缺关键钥匙启动时 fail fast。

# LLM 钥匙（agent 建模型用，DashScope 兼容模式）
DASHSCOPE_API_KEY=sk-xxx

# 内网门钥匙：web/agent → MCP HTTP Server（L2 --http 模式必须；纯 stdio 可不填）
MCP_API_KEY=change-me-mcp

# 外网门钥匙：浏览器 → web.py（L3 Web 模式必须）
WEB_API_TOKEN=change-me-web

# ---------- 非密钥开关（可直接 export，不进 .env 也行） ----------
# APP_ROLE=trader        # 角色：trader 中间商 / buyer 只买 / seller 只卖
# MCP_TRANSPORT=inventory:http  # 混合传输：逗号分隔点名走 HTTP 的座，默认全 stdio
